    "db:setup": "npx tsx scripts/setup-db.ts",
    "db:import": "npx tsx scripts/import-ccrs.ts",
    "format": "oxfmt",
    "posttest": "oxfmt --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.0",
    "cn": "^0.2.6",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.8",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23",
    "typescript": "5.9",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
